{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "simple-mega-menu/mega-menu-link",
  "version": "0.1.7",
  "title": "Mega Menu Link",
  "category": "design",
  "icon": "admin-links",
  "description": "Add a custom link to your mega menu navigation.",
  "keywords": [
    "link",
    "url",
    "navigation",
    "menu"
  ],
  "attributes": {
    "url": {
      "type": "string",
      "default": ""
    },
    "label": {
      "type": "string",
      "default": ""
    },
    "opensInNewTab": {
      "type": "boolean",
      "default": false
    },
    "rel": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "color": {
      "background": true,
      "text": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "spacing": {
      "padding": true,
      "margin": true
    }
  },
  "textdomain": "simple-mega-menu",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}